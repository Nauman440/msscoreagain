# Copy to .env.local for local development. Every setting is optional.

# PostgreSQL connection string. Required on Vercel. Without it, locally, audits are kept in
# memory and lost on restart. POSTGRES_URL (set by Vercel's Neon integration) also works.
# On Railway, add a PostgreSQL service and reference its DATABASE_URL variable.
DATABASE_URL=

# Public address of the site, used in emailed report links (for example https://msscore.com).
PUBLIC_BASE_URL=

# Google PageSpeed Insights key for Core Web Vitals. Strongly recommended on Vercel:
# without it Google often refuses the request and speed shows as "not measured".
PAGESPEED_API_KEY=

# Email delivery through Resend (resend.com). Without these, report emails are only logged.
RESEND_API_KEY=
EMAIL_FROM=MSScore <reports@yourdomain.com>

# Where "Book a call" and "Talk to our team" buttons go. Defaults to the free audit form.
NEXT_PUBLIC_BOOKING_URL=

# Audit limits
AUDIT_PAGE_CAP=50
AUDIT_CRAWL_BUDGET_MS=35000
# Hard limit for one audit. Keep it under 60000, the /api/audits function limit.
AUDIT_TOTAL_BUDGET_MS=52000
AUDIT_REUSE_DAYS=30
AUDIT_RATE_LIMIT_PER_HOUR=10
AUDIT_MAX_CONCURRENT=3

# Development only: allow auditing localhost (used by the test fixture site). Never set in production.
AUDIT_ALLOW_PRIVATE_HOSTS=
# Development only: skip the PageSpeed request.
AUDIT_SKIP_PAGESPEED=
